{
  "name": "amu-agent-2",
  "version": "1.15.0",
  "description": "Autonomous Local AI Developer Engine & API for AMU Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --test src/tests/*.test.ts",
    "test:phase1": "node --experimental-strip-types src/tests/phase1-verification.ts",
    "test:central": "node --experimental-strip-types src/tests/central-server.test.ts",
    "start:supervised": "node scripts/supervise.mjs",
    "start:built": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:embedded": "node --experimental-strip-types src/tests/embedded-engine.test.ts",
    "test:safe": "npm run test:central && npm run test:embedded",
    "test:session2": "node --experimental-strip-types src/tests/session2-core.test.ts && node --experimental-strip-types src/tests/session2-runtime.test.ts",
    "windows:status": "powershell -NoProfile -File scripts/windows-autostart.ps1 -Action Status",
    "test:session3": "node --experimental-strip-types src/tests/session3-platform.test.ts && node --experimental-strip-types src/tests/session3-native.test.ts",
    "snapshot:create": "node --experimental-strip-types scripts/encrypted-backup.mjs create",
    "test:session4": "node --experimental-strip-types src/tests/session4-workers.test.ts && node --experimental-strip-types src/tests/session4-backup.test.ts",
    "worker:init": "node --experimental-strip-types scripts/remote-worker.mjs init",
    "worker:start": "node --experimental-strip-types scripts/remote-worker.mjs start",
    "test:session5": "node --experimental-strip-types src/tests/session5-remote.test.ts && node --experimental-strip-types src/tests/session5-failure.test.ts && node --experimental-strip-types src/tests/session5-management.test.ts && node --experimental-strip-types src/tests/session5-supervisor.test.ts",
    "client:test": "node scripts/test-client-connection.mjs",
    "journal:export": "node scripts/export-identity-journal.mjs",
    "test:session6": "node --experimental-strip-types src/tests/session6-journal.test.ts && node --experimental-strip-types src/tests/session6-management.test.ts && node --experimental-strip-types src/tests/session5-failure.test.ts && node --experimental-strip-types src/tests/session5-remote.test.ts && node --experimental-strip-types src/tests/session6-diagnostics.test.ts",
    "backup:export": "node --experimental-strip-types scripts/encrypted-backup.mjs export",
    "rollback:manual": "node scripts/manual-rollback.mjs",
    "test:session7": "node src/tests/session7-operations.test.mjs && node --experimental-strip-types src/tests/session7-acceptance.test.ts",
    "test:session8": "node --experimental-strip-types src/tests/session8-management.test.mjs && node --experimental-strip-types src/tests/session8-events.test.ts",
    "test:session9": "node --experimental-strip-types src/tests/session9-access.test.mjs && node --experimental-strip-types src/tests/session9-dashboard.test.mjs",
    "test:session10": "node --experimental-strip-types src/tests/session10-coding.test.mjs && node --experimental-strip-types src/tests/session10-agent.test.mjs && node --experimental-strip-types src/tests/session10-dashboard.test.mjs && node --experimental-strip-types src/tests/session10-template.test.mjs",
    "test:session11": "node src/tests/session11-development.test.mjs && node src/tests/session11-dashboard.test.mjs",
    "test:session12": "node src/tests/session12-agent.test.mjs && node src/tests/session12-dashboard.test.mjs",
    "test:session13": "node src/tests/session13-runner.test.mjs && node src/tests/session13-workflow.test.mjs && node src/tests/session13-dashboard.test.mjs",
    "test:session14": "node src/tests/session14-runner.test.mjs && node src/tests/session14-dashboard.test.mjs",
    "test:session15": "node src/tests/session15-runner.test.mjs && node src/tests/session15-dashboard.test.mjs",
    "test:session16": "node src/tests/session16-runner.test.mjs",
    "runner:inventory": "pwsh -NoProfile -File scripts/runner-environment.ps1 -ProbeWsl",
    "runner:prepare": "node scripts/prepare-runner-setup.mjs",
    "runner:verify": "node scripts/verify-runner-bundle.mjs",
    "runner:preflight": "node scripts/runner-linux-preflight.mjs",
    "test:session17": "node src/tests/session17-setup.test.mjs"
  },
  "keywords": [],
  "author": "AMU Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "node-llama-cpp": "3.22.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "node-llama-cpp": false
  }
}
